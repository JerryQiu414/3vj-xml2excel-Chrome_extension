    "door_keywords": ["门", "Door", "door", "GRD"],

    "door_classification": {
        "rules": [
            {
                "category": "铝框门板",
                "conditions": [
                    {
                        "field": "color",
                        "prefixes": ["GRA"]
                    }
                ],
                "logic": "AND",
                "priority": 0
            },
            {
                "category": "烤漆门板",
                "conditions": [
                    {
                        "field": "color",
                        "prefixes": ["GR51", "GR52", "GR53", "GR54"]
                    }
                ],
                "logic": "AND",
                "priority": 1
            },
            {
                "category": "免漆门板",
                "conditions": [
                    {
                        "field": "color",
                        "prefixes": ["GR1", "GR2", "GR3", "GR4", "GR50","GR6", "GR8"]
                    }
                ],
                "logic": "AND",
                "priority": 2
            }
        ]
    }
}
