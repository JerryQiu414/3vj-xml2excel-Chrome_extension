    "default_supplier": "SUP_DEFAULT",
    "match_types": {
        "prefix": {
            "name": "前缀匹配",
            "description": "匹配以指定字符串开头的编码"
        },
        "suffix": {
            "name": "后缀匹配",
            "description": "匹配以指定字符串结尾的编码"
        },
        "regex": {
            "name": "正则匹配",
            "description": "使用正则表达式匹配编码"
        },
        "exact": {
            "name": "精确匹配",
            "description": "完全匹配指定编码"
        }
    }
