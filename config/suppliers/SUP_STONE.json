{
    "supplier_id": "SUP_STONE",
    "supplier_name": "石材供应商",
    "description": "台面石材、挡水条等石材类物料采购表单",
    "excel_config": {
        "sheet_name": "石材采购单",
        "include_header": true,
        "date_format": "yyyy-MM-dd",
        "auto_size_columns": true,
        "freeze_header": true
    },
    "columns": [
        {
            "column_letter": "A",
            "name": "订单号",
            "mapping": "order_info.OrderNo",
            "data_type": "string",
            "required": true
        },
        {
            "column_letter": "B",
            "name": "客户名称",
            "mapping": "order_info.Customer",
            "data_type": "string",
            "required": true
        },
        {
            "column_letter": "C",
            "name": "交货日期",
            "mapping": "order_info.DeliveryDate",
            "data_type": "date",
            "required": true
        },
        {
            "column_letter": "D",
            "name": "物料编码",
            "mapping": "custom_code",
            "data_type": "string",
            "custom_code": "row_data.get('materialDesignCode', '') or row_data.get('materialName', '')[:10] if row_data.get('materialName') else ''"
        },
        {
            "column_letter": "E",
            "name": "物料名称",
            "mapping": "row.materialName",
            "data_type": "string"
        },
        {
            "column_letter": "F",
            "name": "规格尺寸",
            "mapping": "custom_code",
            "data_type": "string",
            "custom_code": "f\"{row_data.get('width', '')}x{row_data.get('depth', '')}x{row_data.get('height', '')}\""
        },
        {
            "column_letter": "G",
            "name": "数量",
            "mapping": "row.Num",
            "data_type": "number",
            "default_value": 1
        },
        {
            "column_letter": "H",
            "name": "单位",
            "mapping": "custom:件",
            "data_type": "string"
        },
        {
            "column_letter": "I",
            "name": "颜色",
            "mapping": "row.colorName",
            "data_type": "string"
        },
        {
            "column_letter": "J",
            "name": "备注",
            "mapping": "custom:",
            "data_type": "string"
        }
    ],
    "filter_rules": [
        {
            "name": "只处理SubTable类型",
            "enabled": true,
            "expression": "row_type == 'SubTable'"
        }
    ],
    "post_process_rules": [
        {
            "name": "空值替换为NULL",
            "enabled": true,
            "column_letters": ["D", "E", "I"],
            "rule_type": "empty_replace",
            "default_value": "null"
        }
    ],
    "output_rules": {
        "split_by_cabinet": true,
        "file_naming": "{supplier_name}_{order_no}_{timestamp}.xlsx"
    }
}
