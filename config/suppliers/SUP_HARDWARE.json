{
    "supplier_id": "SUP_HARDWARE",
    "supplier_name": "五金供应商",
    "description": "铰链、导轨、拉手等五金配件采购表单",
    "excel_config": {
        "sheet_name": "五金采购单",
        "include_header": true,
        "date_format": "yyyy-MM-dd",
        "auto_size_columns": true,
        "freeze_header": true
    },
    "columns": [
        {
            "column_letter": "A",
            "name": "订单号",
            "mapping": "order_info.OrderNo",
            "data_type": "string",
            "required": true
        },
        {
            "column_letter": "B",
            "name": "客户名称",
            "mapping": "order_info.Customer",
            "data_type": "string",
            "required": true
        },
        {
            "column_letter": "C",
            "name": "交货日期",
            "mapping": "order_info.DeliveryDate",
            "data_type": "date",
            "required": true
        },
        {
            "column_letter": "D",
            "name": "物料编码",
            "mapping": "row.PartNumber",
            "data_type": "string",
            "required": true,
            "transform": {
                "type": "remove_suffix",
                "suffixes": ["TZ", "Z", "T"]
            }
        },
        {
            "column_letter": "E",
            "name": "物料名称",
            "mapping": "row.Name",
            "data_type": "string"
        },
        {
            "column_letter": "F",
            "name": "规格型号",
            "mapping": "custom_code",
            "data_type": "string",
            "custom_code": "row_data.get('spec', '') or row_data.get('model', '') or ''"
        },
        {
            "column_letter": "G",
            "name": "数量",
            "mapping": "custom_code",
            "data_type": "number",
            "custom_code": "row_data.get('Num', 1) * order_info.get('OrderCount', 1)"
        },
        {
            "column_letter": "H",
            "name": "单位",
            "mapping": "row.Unit",
            "data_type": "string",
            "default_value": "个"
        },
        {
            "column_letter": "I",
            "name": "材质",
            "mapping": "row.materialName",
            "data_type": "string"
        },
        {
            "column_letter": "J",
            "name": "表面处理",
            "mapping": "custom:",
            "data_type": "string"
        },
        {
            "column_letter": "K",
            "name": "备注",
            "mapping": "custom:",
            "data_type": "string"
        }
    ],
    "filter_rules": [
        {
            "name": "只处理Metal类型",
            "enabled": true,
            "expression": "row_type == 'Metal'"
        },
        {
            "name": "排除外购五金",
            "enabled": true,
            "expression": "row_data.get('unitTransfer', '') != 'WU'"
        }
    ],
    "post_process_rules": [
        {
            "name": "合并相同编码",
            "enabled": true,
            "rule_type": "metal_merge",
            "key_column": "D"
        },
        {
            "name": "空值替换为NULL",
            "enabled": true,
            "column_letters": ["F", "I"],
            "rule_type": "empty_replace",
            "default_value": "NULL"
        }
    ],
    "output_rules": {
        "split_by_cabinet": true,
        "file_naming": "{supplier_name}_{order_no}_{timestamp}.xlsx"
    }
}
